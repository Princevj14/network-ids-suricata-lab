alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible SYN port scan detected"; flags:S; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp $HOME_NET any -> any 4444 (msg:"CUSTOM Possible reverse shell outbound to known shell port"; flags:S; classtype:trojan-activity; sid:1000002; rev:1;)
